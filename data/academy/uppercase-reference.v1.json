        3
      ],
      "kind": "Sachfehler",
      "issue": "Die „Wichtigen Verhältnisse“ mit Prozentspannen wirken wie feste Regeln.",
      "correction": "Es sind Beispielwerte für diese eine Zeichnung. Breite, Teilung der Höhe und Winkel sind Gestaltungsentscheidungen."
    },
    {
      "id": "feld-9-raster",
      "panels": [
        9
      ],
      "kind": "Sachfehler",
      "issue": "Aufgabe 1 wiederholt die Spanne als Vorgabe (z. B. „B = 60–80 %“).",
      "correction": "Die Spanne ist nur ein Anhaltspunkt. Wähle eine eigene Breite und begründe sie."
    },
    {
      "id": "feld-8-throw-up",
      "panels": [
        8
      ],
      "kind": "Sachfehler",
      "issue": "„Throw-up: einfach, rund, schnell“: Das Tempo ist am Bild nicht ablesbar, und ein Throw-up muss weder rund noch zweifarbig sein.",
      "correction": "Besser: „Throw-up-Richtung: kompakt, gerundet“."
    },
    {
      "id": "feld-8-keine-stufen",
      "panels": [
        8
      ],
      "kind": "Einordnung",
      "issue": "„Vom Grundzeichen zum Style“ kann wie eine Reihenfolge wirken.",
      "correction": "Throw-up, Block-Style und Wildstyle sind gleichwertige Richtungen, keine Stufenleiter."
    },
    {
      "id": "feld-7-bewegung",
      "panels": [
        7
      ],
      "kind": "Prozessbehauptung",
      "issue": "Formulierungen wie „entsteht aus …“, „wird in einem Zug geschrieben“ oder eine feste Zahl von Zügen klingen wie beobachtete Bewegungen.",
      "correction": "Strichfolge, Druck und Tempo sind an einem fertigen Buchstaben nicht ablesbar. Feder- und Pinseltechnik lassen sich nicht direkt auf die Sprühdose übertragen."
    },
    {
      "id": "feld-4-schritte",
      "panels": [
        4
      ],
      "kind": "Darstellung",
      "issue": "Schritt 4 („Kontur verbinden“) und Schritt 5 („Form verfeinern“) sehen oft fast gleich aus.",
      "correction": "Merke: Schritt 4 ist die geschlossene Umrisslinie, Schritt 5 die gefüllte Grundform."
    },
    {
      "id": "lesbarkeit",
      "panels": [
        5,
        6,
        8
      ],
      "kind": "Lesbarkeit",
      "issue": "Runde und organische Varianten verlieren teils die Lesbarkeit und sehen aus wie 8, 3, & oder 2.",
      "correction": "Beim Üben prüfen: Ist der Buchstabe ohne Zusammenhang noch erkennbar?"
    },
    {
      "id": "feld-2-punze",
      "panels": [
        2
      ],
      "kind": "Begriff",
      "issue": "Innenräume und offene Räume sind eigene Bauteile, werden aber oft nicht beschriftet. Einige Blätter nennen sie „Theke“ oder „Auge“.",
      "correction": "Das Fachwort für den Innenraum ist Punze. „Auge“ meint meist den geschlossenen Innenraum des kleinen e."
    },
    {
      "id": "feld-1-neutral",
      "panels": [
        1
      ],
      "kind": "Einordnung",
      "issue": "Die „neutrale Grundform“ wirkt wie die eine richtige Form.",
      "correction": "Sie ist eine von vielen möglichen Grundformen. Eine Normform gibt es nicht."
    }
  ],
