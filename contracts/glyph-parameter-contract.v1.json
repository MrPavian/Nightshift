{
  "contractId": "nightshift.glyph-parameter-contract",
  "version": "1.0.0",
  "status": "design-specification",
  "scope": {
    "glyphs": [
      "latin.upper.A",
      "latin.upper.B",
      "latin.upper.G",
      "latin.upper.R",
      "latin.upper.S"
    ],
    "variantMatrix": "research/MASTER_GLYPH_VARIANT_MATRIX_01.md"
  },
  "principles": [
    "Canonical semantic/vector model is authoritative; Three.js scene objects are derived.",
    "Every user edit is a typed command with stable IDs and atomic validation/commit.",
    "Numeric bounds remain uncalibrated until measured from reviewed geometry.",
    "Topology-changing variants are explicit authored variants, never ordinary continuous controls.",
    "Rendering parameters cannot mutate semantic geometry."
  ],
  "parameterValuePolicy": {
    "numeric": {
      "bounds": "calibration-reference-required",
      "unit": "glyph-local-or-normalized; declared per parameter after calibration",
      "defaultValue": "authored-master-or-grammar-default",
      "clampPolicy": "never silently clamp; reject or return actionable warning"
    },
    "enum": {
      "values": "declared per parameter"
    },
    "vector": {
      "coordinateSpace": "glyph-local"
    }
  },
  "commandEnvelope": {
    "required": [
      "commandId",
      "operationId",
      "glyphInstanceId",
      "variantId",
      "expectedRevision",
      "parameterPatch"
    ],
    "fields": {
      "commandId": "stable unique command identifier",
      "operationId": "registered operation identifier",
      "glyphInstanceId": "stable project instance identifier",
      "variantId": "stable authored glyph variant identifier",
      "expectedRevision": "revision used for optimistic concurrency",
      "parameterPatch": "typed parameter values only; no direct mesh mutation",
      "source": "ui|threejs-handle|automation|import",
      "seed": "required only when operation explicitly uses deterministic procedural variation"
    },
    "transaction": {
      "sequence": [
        "resolve-target",
        "check-revision",
        "validate-input-types",
        "derive-dependent-geometry",
        "run-hard-constraints",
        "run-soft-diagnostics",
        "commit-canonical-state-atomically",
        "increment-revision",
        "invalidate-derived-views"
      ],
      "failure": "reject-entire-command; preserve prior canonical state and revision",
      "undoRedo": "store inverse canonical patch and forward patch; replay through same validation pipeline",
      "determinism": "same canonical input, command, seed and generator version must produce same canonical output"
    }
  },
  "dependencyKinds": {
    "geometry": "rebuild or update canonical vector geometry",
    "metrics": "recompute glyph bounds/metrics",
    "topology": "revalidate counter/aperture/channel topology",
    "anchors": "recompute anchor positions/directions/clearance",
    "composition": "invalidate pair/word relationships and collision analysis",
    "diagnostics": "rerun named checks"
  },
  "diagnostics": [
    {
      "code": "GLYPH_IDENTITY_DRIFT",
      "severity": "error",
      "meaning": "glyph no longer satisfies its identity invariants"
    },
    {
      "code": "COUNTER_COLLAPSED",
      "severity": "error",
      "meaning": "protected counter disappears or becomes invalid"
    },
    {
      "code": "COUNTER_CLEARANCE_LOW",
      "severity": "error",
      "meaning": "counter clearance is below calibrated minimum"
    },
    {
      "code": "APERTURE_CLOSED",
      "severity": "error",
      "meaning": "protected exterior-connected opening is closed"
    },
    {
      "code": "COMPONENT_DISCONNECTED",
      "severity": "error",
      "meaning": "required semantic components lose required connectivity"
    },
    {
      "code": "SELF_INTERSECTION",
      "severity": "error",
      "meaning": "prohibited contour self-intersection detected"
    },
    {
      "code": "JUNCTION_INVALID",
      "severity": "error",
      "meaning": "component junction fails topology or local thickness constraints"
    },
    {
      "code": "ANCHOR_OUT_OF_ENVELOPE",
      "severity": "error",
      "meaning": "anchor leaves its declared validity envelope"
    },
    {
      "code": "PAIR_COLLISION",
      "severity": "warning",
      "meaning": "glyph geometry conflicts with a neighboring glyph"
    },
    {
      "code": "WORD_FLOW_DEGRADED",
      "severity": "warning",
      "meaning": "word rhythm or negative-space channel falls outside preference"
    },
    {
      "code": "SOFT_PREFERENCE_MISSED",
      "severity": "warning",
      "meaning": "non-critical stylistic preference is not met"
    },
    {
      "code": "CALIBRATION_REQUIRED",
      "severity": "warning",
      "meaning": "a metric needed for a numeric threshold is not calibrated"
    }
  ],
  "globalRules": [
    {
      "id": "rule.identity",
      "kind": "hard",
      "check": "identity-invariants"
    },
    {
      "id": "rule.topology",
      "kind": "hard",
      "check": "protected-counter-aperture-connectivity"
    },
    {
      "id": "rule.geometry",
      "kind": "hard",
      "check": "self-intersection-and-valid-contours"
    },
    {
      "id": "rule.anchors",
      "kind": "hard",
      "check": "anchor-validity-envelopes"
    },
    {
      "id": "rule.determinism",
      "kind": "hard",
      "check": "deterministic-regeneration"
    },
    {
      "id": "rule.word-rhythm",
      "kind": "soft",
      "check": "preferred-width-spacing-and-silhouette"
    },
    {
      "id": "rule.style-density",
      "kind": "soft",
      "check": "preferred-stylistic-density"
    }
  ],
